# MoguMogu バックエンド設定サンプル。
# コピーして .env にリネームし、値を設定してください（.env は git 管理外）。

# 実行環境: development | production
APP_ENV=development

# 本番では必ず設定（32文字以上のランダム値）。例: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
# アクセストークンの有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 許可するオリジン（カンマ区切り）。本番は localhost 禁止。
CORS_ORIGINS_RAW=http://localhost:3000

# ログイン・登録のレート制限
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# データベース（本番は PostgreSQL 等。SQLite はローカル開発用）
DATABASE_URL=sqlite:///./hoiku_recipe.db

# AI 献立生成・画像 OCR（Gemini の OpenAI 互換 API）。
# AI_API_KEY 未設定時は献立生成がルールベースに、画像 OCR がエラーにフォールバック。
# 無料の API キーは https://aistudio.google.com で取得（Google アカウント必須）。
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=
# AI_TIMEOUT_SECONDS=120