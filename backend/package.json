{
  "name": "mogumogu-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "lint": "ruff check . && ruff format --check .",
    "format": "ruff check --fix . && ruff format .",
    "typecheck": "mypy .",
    "test": "pytest --cov=app --cov-report=term-missing --cov-report=xml",
    "test:watch": "pytest --watch",
    "db:init": "python -c \"from app.database import init_db; init_db()\"",
    "db:migrate": "alembic upgrade head",
    "db:makemigrations": "alembic revision --autogenerate -m"
  },
  "devDependencies": {}
}
